# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and must never be committed.

# development locally, production on your host
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Public address of the website (no trailing slash). Used for sitemap.xml and robots.txt.
SITE_URL=http://localhost:5000

# SMTP settings (example uses Gmail)
# For Gmail, create an "App Password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password_here

# Where enquiry emails should be delivered (defaults to SMTP_USER if empty)
TO_EMAIL=owner@example.com

# Number of reverse proxies in front of the app. Defaults to 1 in production and off locally.
# Needed so the enquiry-form rate limit works per visitor.
# TRUST_PROXY=1
